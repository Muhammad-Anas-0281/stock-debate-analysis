# =============================================================
# Multi-Agent Stock Debate System — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- Application ---
APP_ENV=development           # development | production
APP_NAME="Stock Debate System"
APP_VERSION="1.0.0"
DEBUG=true

# --- Security (REQUIRED) ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_key_here_minimum_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) ---
POSTGRES_USER=stockdebate
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=stockdebate_db
POSTGRES_HOST=localhost         # Use 'db' inside Docker Compose
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://stockdebate:your_db_password_here@localhost:5432/stockdebate_db

# --- Redis ---
REDIS_HOST=localhost            # Use 'redis' inside Docker Compose
REDIS_PORT=6379
REDIS_PASSWORD=                 # Leave empty if no password
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AI / LLM (REQUIRED) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192
LLM_MAX_TOKENS=2048

# --- Financial Data APIs (REQUIRED) ---
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# NewsAPI: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here
NEWS_API_BASE_URL=https://newsapi.org/v2

# --- Pinecone Vector DB (REQUIRED) ---
# https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=stock-debate-embeddings
PINECONE_DIMENSION=1536

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME="Stock Debate System"

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging ---
LOG_LEVEL=INFO
